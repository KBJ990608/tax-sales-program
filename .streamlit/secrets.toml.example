# 이 파일을 secrets.toml 로 복사하고 값을 채우세요. (secrets.toml 은 git에 올라가지 않음)
# Streamlit Cloud 배포 시에는 App settings → Secrets 에 아래 내용을 붙여넣으세요.

# [필수] 관리 화면(명단·발송·이력) 잠금 비밀번호.
# 설정하지 않으면 관리 화면이 열리지 않습니다(fail-closed).
admin_password = "여기에_강력한_비밀번호"

# [선택] AI 맞춤 문안 생성용 Anthropic API 키. 없으면 고정 템플릿 5종만 사용합니다.
# anthropic_api_key = "sk-ant-..."

# [선택] 발신 Gmail 기본값. 넣어두면 ③ 메일 보내기 화면에 자동으로 채워집니다.
# gmail_address = "you@gmail.com"
# gmail_app_password = "구글 앱 비밀번호 16자리(일반 비밀번호 아님)"
# sender_name = "행복세무회계 김세무"
