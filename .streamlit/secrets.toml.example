# 이 파일을 같은 폴더에 secrets.toml 로 복사하고 값을 채우세요.
# secrets.toml 은 .gitignore 로 제외되어 Git 에 올라가지 않습니다.
#
# Streamlit Community Cloud 배포 시에는 파일을 만들 필요 없이
#   share.streamlit.io → 앱 선택 → Settings → Secrets
# 에 아래 내용을 그대로 붙여넣고 값만 바꾸면 됩니다.
#
# ⚠️ 실제 비밀번호·API 키를 이 예시 파일(.example)에 적어 커밋하지 마세요.

# ── [필수] 관리자 비밀번호 ────────────────────────────────────────────────
# ② 명단 관리 / ③ 메일 보내기 / ④ 발송 이력 화면을 여는 비밀번호입니다.
# 설정하지 않으면 관리 화면이 아예 열리지 않습니다(fail-closed).
# CHANGE_ME 를 그대로 쓰지 말고 반드시 직접 만든 값으로 바꾸세요.
admin_password = "CHANGE_ME"

# ── [선택] AI 맞춤 문안 생성 ──────────────────────────────────────────────
# Anthropic API 키. 비워 두면 AI 생성 버튼만 비활성화되고
# 앱과 고정 템플릿 5종은 정상 동작합니다.
anthropic_api_key = ""

# ── [선택] 발신 Gmail 기본값 ──────────────────────────────────────────────
# 넣어두면 ③ 메일 보내기 화면에 자동으로 채워집니다.
# 비워 두면 발송할 때 화면에서 직접 입력하면 됩니다.
# gmail_app_password 는 구글 계정 → 보안 → 2단계 인증 → 앱 비밀번호에서
# 발급한 16자리이며, 구글 계정의 일반 비밀번호가 아닙니다.
gmail_address = ""
gmail_app_password = ""
sender_name = ""
